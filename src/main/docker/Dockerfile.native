####
# Dockerfile para executar o beebite-ifood-service em modo Nativo (GraalVM / Mandrel - sem JVM)
#
# 1. Compilar o binário nativo Linux:
#    ./mvnw package -Dnative -DskipTests -Dquarkus.native.container-build=true
#
# 2. Construir a imagem Docker:
#    docker build -f src/main/docker/Dockerfile.native -t us-east1-docker.pkg.dev/beebite-prd/beebite-repo/beebite-ifood-service:latest .
####
FROM registry.access.redhat.com/ubi9/ubi-minimal:9.7
WORKDIR /work/
RUN mkdir -p /data/images/catalog \
    && chown -R 1001:root /work /data \
    && chmod -R "g+rwX" /work /data
COPY --chown=1001:root --chmod=0755 target/*-runner /work/application

EXPOSE 8081
USER 1001

ENTRYPOINT ["./application", "-Dquarkus.http.host=0.0.0.0"]

